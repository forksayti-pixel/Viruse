def open_url(url):
    system = platform.system()

    if system == "Windows":
        subprocess.Popen(["cmd", "/c", "start", "", url], shell=True)

    elif system == "Linux":
        subprocess.Popen(["xdg-open", url])

    elif "Android" in platform.platform():
        os.system(f'termux-open-url "{url}"')

    else:
        webbrowser.open_new_tab(url)


